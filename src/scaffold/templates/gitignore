# This file is yours — fastagent writes it once, at `init`, and never touches git again.

# dependencies (reinstalled at deploy)
node_modules/

# fastagent machinery: credentials and machine state never belong in git.
# `.secrets/*` (not `.secrets/`) so the committable template below can be re-included.
.secrets/*
!.secrets/.env.example
.state/
.cache/

# fastagent reads the agent's env from .secrets/.env, but a bare .env at this level is the file
# habit puts here — `dev` says so when it finds one; this keeps it uncommittable meanwhile.
.env
.env.*
!.env.example
